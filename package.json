{
  "name": "asmr-one-plus",
  "version": "1.2.0",
  "private": true,
  "type": "module",
  "description": "Solo voice actor filtering, playback progress, listening history and local follows for asmr.one",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "node scripts/build.mjs",
    "test": "node --test scripts/test-solo.mjs",
    "check": "node scripts/build.mjs --check"
  },
  "userscript": {
    "name": "asmr.one plus",
    "namespace": "asmr-one-plus",
    "description": "为 asmr.one 提供单人出演筛选、播放进度保存、播放历史、本地关注和数据管理，并补充界面与播放器操作提示。",
    "match": [
      "https://asmr.one/*",
      "https://www.asmr.one/*",
      "https://asmr-100.com/*",
      "https://www.asmr-100.com/*",
      "https://asmr-200.com/*",
      "https://www.asmr-200.com/*",
      "https://asmr-300.com/*",
      "https://www.asmr-300.com/*"
    ],
    "grant": [
      "GM_getValue",
      "GM_setValue",
      "GM_deleteValue",
      "GM_addStyle",
      "GM_registerMenuCommand",
      "unsafeWindow"
    ],
    "run-at": "document-idle",
    "downloadURL": "https://update.sleazyfork.org/scripts/603419/asmrone%20plus.user.js",
    "updateURL": "https://update.sleazyfork.org/scripts/603419/asmrone%20plus.meta.js"
  },
  "devDependencies": {
    "esbuild": "0.28.2"
  }
}
